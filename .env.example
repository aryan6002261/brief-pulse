# Required: Tavily API Key (get one at https://app.tavily.com)
TAVILY_API_KEY=tvly-your-api-key-here

# Optional: LLM Synthesis Gateway (Bifrost by Maxim AI, OpenAI, or Gemini)
# If omitted, BriefPulse uses its built-in Native Tavily Synthesis Engine automatically.
# BIFROST_BASE_URL=http://localhost:8080/v1
# BIFROST_API_KEY=
# BIFROST_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

